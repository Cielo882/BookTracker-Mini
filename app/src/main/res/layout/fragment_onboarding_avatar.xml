<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/crea_tu_avatar"
            android:textSize="28sp"
            style="@style/TextAppearance.BookTracker.Headline"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dibuja_una_carita_con_tu_dedo"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="24dp" />

        <!-- Canvas para dibujar -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"

            android:focusable="true">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="280dp"
                android:layout_height="280dp"
                app:cardCornerRadius="140dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="?attr/colorSurface"
                android:layout_marginBottom="24dp">

                <com.cielo.applibros.presentation.views.DrawableAvatarView
                    android:id="@+id/avatarView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Paleta de colores -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/icons_palette"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/elige_un_color"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"

                android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnColor1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                android:background="@drawable/color_button_selector"
                android:contentDescription="@string/negro"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btnColor2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                android:background="@drawable/color_button_selector"
                android:contentDescription="@string/rojo"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btnColor3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                android:background="@drawable/color_button_selector"
                android:contentDescription="@string/verde"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btnColor4"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                android:background="@drawable/color_button_selector"
                android:contentDescription="@string/azul"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btnColor5"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                android:background="@drawable/color_button_selector"
                android:contentDescription="@string/amarillo"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btnColor6"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                android:background="@drawable/color_button_selector"
                android:contentDescription="@string/morado"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <!-- Botón borrar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            style="@style/Button.Primary2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            app:icon="@drawable/ic_delete"
            app:iconSize="25dp"

            app:iconTint="?attr/colorOnSurface"
            app:iconGravity="textStart"
            app:iconPadding="8dp"

            android:text="@string/borrar_dibujo"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="19sp"
            android:layout_marginBottom="24dp" />


        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline"
            android:layout_marginVertical="16dp" />

        <!-- Opción alternativa -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="O "
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnUseInitial"
            style="@style/Button.Secondary2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/usar_mi_inicial"
            android:textColor="?attr/colorOnSurface"

            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>