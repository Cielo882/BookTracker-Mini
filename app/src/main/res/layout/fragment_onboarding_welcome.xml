<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="?attr/colorPrimary">

    <!-- Ícono grande -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="152dp"
        android:layout_height="152dp"

        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:cardCornerRadius="99dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo3" />
    </com.google.android.material.card.MaterialCardView>



    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BookTracker Mini"
        android:textSize="36sp"
        style="@style/TextAppearance.BookTracker.Headline"
        android:textColor="?attr/colorOnPrimary"
        android:layout_marginBottom="16dp" />

    <!-- Subtítulo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tu registro personal"
        android:textSize="18sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAlignment="center"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Descripción -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Organiza tu colección, registra tu progreso y descubre tu próxima lectura favorita"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:textAlignment="center"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3" />

</LinearLayout>