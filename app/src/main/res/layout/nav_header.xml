<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorPrimary"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="48dp"
    android:paddingBottom="24dp"
    android:clickable="true"
    android:focusable="true"
    android:fitsSystemWindows="true">

    <!-- Avatar -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="88dp"
        android:layout_height="88dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Dibujo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatarDrawing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="44dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <ImageView
                android:id="@+id/ivAvatarDrawing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Inicial -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatarInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="44dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="?attr/colorOnPrimary">

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="P"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:gravity="center" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Nombre -->
    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lector Apasionado"
        style="@style/TextAppearance.BookTracker.Headline"
        android:textSize="22sp"
        android:textColor="?attr/colorOnPrimary"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/avatarContainer"
        app:layout_constraintStart_toStartOf="@id/avatarContainer" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvReaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lector apasionado 🔥"
        android:textSize="14sp"
        android:textColor="?attr/colorOnPrimary"
        android:alpha="0.9"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvUserName"
        app:layout_constraintStart_toStartOf="@id/avatarContainer" />

    <!-- Hint editar -->
    <TextView
        android:id="@+id/tvEditProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✏️ Toca para personalizar"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:alpha="0.7"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvReaderTitle"
        app:layout_constraintStart_toStartOf="@id/avatarContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
